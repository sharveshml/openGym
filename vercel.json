{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && npm ci --ignore-scripts",
  "buildCommand": "cd frontend && npm run build && if [ -z \"$VITE_IMG_BASE\" ]; then mkdir -p dist/exercise-media && cp -r ../catalogue/media/still ../catalogue/media/clip dist/exercise-media/; fi",
  "outputDirectory": "frontend/dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://REPLACE-WITH-YOUR-API-HOST/api/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|json|html)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|ico|svg|woff|woff2|webp|avif|mp4)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }]
    },
    {
      "source": "/exercise-media/(.*)",
      "headers": [{ "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }]
    }
  ]
}
